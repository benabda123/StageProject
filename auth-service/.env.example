# Auth Service - variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs réelles (NE JAMAIS committer .env)

PORT=8084
KEYCLOAK_URL=http://keycloak:8080
REALM=keystone
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Base de données PostgreSQL (codes de réinitialisation de mot de passe)
DB_HOST=localhost
DB_PORT=5441
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=auth_db

# SMTP (envoi des emails) - ex: compte Gmail + mot de passe d'application
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre.email@gmail.com
SMTP_PASSWORD=votre_mot_de_passe_application
